# ---------------------------------------------------------------------------
st.title("분류 모델")
st.write("나이·혈당 같은 정보만으로 뇌졸중 여부를 얼마나 맞힐 수 있는지 두 가지 모델로 살펴봅니다.")

if not DATA_URL.strip():
    st.error("파일 맨 위의 DATA_URL에 첫 화면과 같은 데이터 주소를 넣어 주세요.")
    st.stop()

try:
    raw = load_data(DATA_URL)
except Exception as e:  # noqa: BLE001
    st.error(f"데이터를 불러오지 못했습니다: {e}")
    st.stop()

df = prepare(raw)

selected = st.multiselect(
    "입력으로 사용할 속성",
    options=FEATURES,
    default=DEFAULT_FEATURES,
    format_func=lambda f: KOREAN[f],
)
selected = [f for f in FEATURES if f in selected]  # 고른 순서와 상관없이 늘 같은 순서로
if len(selected) < 2:
    st.warning("입력 속성을 두 개 이상 골라 주세요. 두 개보다 적으면 모델과 그림을 만들 수 없습니다.")
    st.stop()

# bmi를 뺀 나머지 열에 빈칸이 있으면 멈춘다 (bmi만 훈련용 중앙값으로 채운다)
check_cols = ["stroke"] + [f for f in selected if f != "bmi"]
if df[check_cols].isna().any().any():
    bad = [c for c in check_cols if df[c].isna().any()]
    st.error("다음 열에 비어 있거나 숫자가 아닌 값이 있어 진행할 수 없습니다: " + ", ".join(bad))
    st.stop()

train, test = split_train_test(df)
X_train, X_test = train[selected].copy(), test[selected].copy()
y_train, y_test = train["stroke"].astype(int), test["stroke"].astype(int)

st.caption(
    f"뇌졸중(stroke=1)을 양성으로 둡니다. 번호(id) 순으로 정렬해 열 명씩 묶고, 각 묶음의 앞 세 명을 "
    f"테스트용({len(test):,}명)으로 고정했습니다. 나머지 {len(train):,}명으로만 학습과 크기 맞추기를 합니다."
)

if "bmi" in selected:
    bmi_median = float(X_train["bmi"].median())
    n_na_train, n_na_test = int(X_train["bmi"].isna().sum()), int(X_test["bmi"].isna().sum())
    X_train["bmi"] = X_train["bmi"].fillna(bmi_median)
    X_test["bmi"] = X_test["bmi"].fillna(bmi_median)
    st.caption(
        f"체질량지수가 비어 있는 사람(훈련용 {n_na_train:,}명, 테스트용 {n_na_test:,}명)은 "
        f"훈련용의 중앙값 {bmi_median:.1f}으로 채웠습니다."
    )

# --- 모델 만들기 -----------------------------------------------------------
logit = make_pipeline(StandardScaler(), LogisticRegression(max_iter=1000))
logit.fit(X_train, y_train)  # 크기 맞추기도 훈련용으로만 계산된다

tree = DecisionTreeClassifier(max_depth=3, min_samples_split=5, random_state=42)
tree.fit(X_train, y_train)
st.caption(
    "의사결정트리는 값의 크기에 영향을 받지 않아 크기 맞추기 없이 원래 값으로 학습했습니다. "
    "질문은 세 번까지만 던지고, 마디에 사람이 다섯 명 미만이면 더 나누지 않습니다."
)

baseline = DummyClassifier(strategy="most_frequent")
baseline.fit(X_train, y_train)


def accuracies(model):
    return (
        accuracy_score(y_train, model.predict(X_train)),
        accuracy_score(y_test, model.predict(X_test)),
    )


# --- 정확도 카드 -----------------------------------------------------------
st.subheader("정확도")
c1, c2, c3 = st.columns(3)
accuracy_card(c1, LOGIT_NAME, *accuracies(logit))
accuracy_card(c2, TREE_NAME, *accuracies(tree))
accuracy_card(c3, BASE_NAME, *accuracies(baseline))

# --- 산점도 ----------------------------------------------------------------
st.subheader("테스트 데이터와 두 모델이 가르는 자리")
sc1, sc2 = st.columns(2)
x_feat = sc1.selectbox("가로축", selected, index=0, format_func=lambda f: KOREAN[f])
y_options = [f for f in selected if f != x_feat]
y_feat = sc2.selectbox("세로축", y_options, index=0, format_func=lambda f: KOREAN[f])

fixed = X_test.median()  # 두 축이 아닌 속성을 세워 둘 값
xr = axis_range(X_test[x_feat], x_feat)
yr = axis_range(X_test[y_feat], y_feat)

fig = go.Figure()

# 의사결정트리가 나눈 칸 (옅은 색)
xs = np.linspace(xr[0], xr[1], 160)
ys = np.linspace(yr[0], yr[1], 160)
gx, gy = np.meshgrid(xs, ys)
grid = pd.DataFrame({f: np.full(gx.size, fixed[f]) for f in selected})
grid[x_feat] = gx.ravel()
grid[y_feat] = gy.ravel()
region = tree.predict(grid[selected]).reshape(gx.shape)
fig.add_trace(
    go.Heatmap(
        x=xs,
        y=ys,
        z=region,
        zmin=0,
        zmax=1,
        colorscale=[[0, BLUE_LIGHT], [1, ORANGE_LIGHT]],
        showscale=False,
        hoverinfo="skip",
        showlegend=False,
    )
)
present = set(np.unique(region).astype(int).tolist())
for cls, color, label in [
    (0, BLUE_LIGHT, "의사결정트리가 '아님'이라고 답하는 칸"),
    (1, ORANGE_LIGHT, "의사결정트리가 '뇌졸중'이라고 답하는 칸"),
]:
    if cls in present:
        fig.add_trace(
            go.Scatter(
                x=[None],
                y=[None],
                mode="markers",
                marker=dict(symbol="square", size=14, color=color),
                name=label,
            )
        )

# 로지스틱 회귀가 0.5로 가르는 선
segment, side = logistic_line(logit, selected, fixed, x_feat, y_feat, xr, yr)
if segment is not None:
    (x0, y0), (x1, y1) = segment
    fig.add_trace(
        go.Scatter(
            x=[x0, x1],
            y=[y0, y1],
            mode="lines",
            line=dict(color=LINE_COLOR, width=3),
            name="로지스틱 회귀가 0.5로 가르는 선",
            hoverinfo="skip",
        )
    )

# 테스트 데이터 점 (실제 뇌졸중 여부로 색을 나눈다)
rng = np.random.default_rng(0)
px = X_test[x_feat].to_numpy(dtype=float)
py = X_test[y_feat].to_numpy(dtype=float)
shown_x = px + rng.uniform(-0.06, 0.06, len(px)) if x_feat in BINARY else px
shown_y = py + rng.uniform(-0.06, 0.06, len(py)) if y_feat in BINARY else py
x_fmt = ".0f" if x_feat in BINARY else ".1f"
y_fmt = ".0f" if y_feat in BINARY else ".1f"
for value, color, size, label in [
    (0, BLUE, 6, "실제로 뇌졸중이 아님"),
    (1, ORANGE, 8, "실제로 뇌졸중을 겪음(양성)"),
]:
    m = (y_test == value).to_numpy()
    fig.add_trace(
        go.Scatter(
            x=shown_x[m],
            y=shown_y[m],
            mode="markers",
            name=label,
            marker=dict(color=color, size=size, opacity=0.75, line=dict(width=0.5, color="rgba(0,0,0,0.35)")),
            customdata=np.column_stack([px[m], py[m]]),
            hovertemplate=(
                f"{KOREAN[x_feat]}: %{{customdata[0]:{x_fmt}}}<br>"
                f"{KOREAN[y_feat]}: %{{customdata[1]:{y_fmt}}}<extra>{label}</extra>"
            ),
        )
    )

fig.update_xaxes(title_text=KOREAN[x_feat], range=list(xr))
fig.update_yaxes(title_text=KOREAN[y_feat], range=list(yr))
for axis_update, feat in [(fig.update_xaxes, x_feat), (fig.update_yaxes, y_feat)]:
    if feat in BINARY:
        axis_update(tickvals=[0, 1], ticktext=["없음", "있음"])
fig.update_layout(
    height=580,
    margin=dict(l=10, r=10, t=20, b=10),
    legend=dict(orientation="h", yanchor="top", y=-0.15, xanchor="left", x=0),
)
st.plotly_chart(fig)

others = [f for f in selected if f not in (x_feat, y_feat)]
if others:
    parts = [f"{KOREAN[f]} {value_text(f, fixed[f])}" for f in others]
    st.write("두 축이 아닌 속성은 테스트 데이터의 중앙값에 세워 두고 계산했습니다: " + ", ".join(parts) + ".")
else:
    st.write("고른 속성이 두 개뿐이라 모두 축으로 쓰였고, 따로 세워 둔 속성은 없습니다.")
if segment is None:
    msg = "로지스틱 회귀가 0.5로 가르는 선은 이 그림의 범위 밖에 있어 그려지지 않았습니다."
    if side is not None:
        msg += f" 이 그림 안에서는 확률 모델이 어디서나 '{side}'이라고 답합니다."
    st.info(msg)
if x_feat in BINARY or y_feat in BINARY:
    st.caption("고혈압·심장병 축은 점이 겹치지 않도록 살짝 흩어서 찍었습니다. 마우스를 올리면 실제 값이 보입니다.")

# --- 의사결정트리 가지 그림 -------------------------------------------------
st.subheader("의사결정트리가 던진 질문")
dot, leaf_answers, asked = tree_dot(tree, X_train, y_train, selected)
try:
    st.graphviz_chart(dot, use_container_width=True)
except TypeError:  # 오래된 스트림릿에는 이 옵션이 없다
    st.graphviz_chart(dot)

n_leaf = len(leaf_answers)
n_no = sum(1 for a in leaf_answers if a == 0)
st.write(
    f"답을 내는 마디는 모두 {n_leaf}칸이고, 그중 {n_no}칸이 '아님'이라고 답합니다. "
    f"(나머지 {n_leaf - n_no}칸은 '뇌졸중'이라고 답합니다.)"
)
if asked:
    st.write("고른 속성 가운데 이 나무가 실제로 물은 것은 " + ", ".join(KOREAN[f] for f in asked) + "입니다.")
else:
    st.write("이 나무는 아무것도 묻지 않고 바로 답을 냈습니다.")
