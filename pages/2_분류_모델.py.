def accuracy_card(col, name, train_acc, test_acc):
    html = (
        f'<div style="min-height:3.6em;font-weight:600;line-height:1.35;">{name}</div>'
        f'<div style="font-size:2.8rem;font-weight:700;line-height:1.2;margin-top:0.2em;">'
        f"{test_acc * 100:.2f}%</div>"
        f'<div style="font-size:0.75rem;opacity:0.7;margin-bottom:0.6em;">테스트 데이터의 정확도</div>'
        f'<div style="display:flex;gap:1.5em;font-size:0.8rem;opacity:0.85;">'
        f"<span>훈련 정확도 {train_acc * 100:.2f}%</span>"
        f"<span>테스트 정확도 {test_acc * 100:.2f}%</span></div>"
    )
    with col:
        with st.container(border=True):
            st.markdown(html, unsafe_allow_html=True)


def value_text(feat, value):
    if feat in BINARY:
        return "있음" if value >= 0.5 else "없음"
    return f"{value:.1f}"


def axis_range(series, feat):
    if feat in BINARY:
        return -0.25, 1.25
    lo, hi = float(series.min()), float(series.max())
    pad = (hi - lo) * 0.05 or 1.0
    return lo - pad, hi + pad


def logistic_line(logit, selected, fixed, x_feat, y_feat, xr, yr):
    """확률 0.5 경계선(z = 0)을 그림 상자 안에서 잘라 돌려준다.

    로지스틱 회귀의 경계선은 원래 값 기준으로 직선이다.
    z = b0 + sum(w_i * v_i) 이고, 두 축이 아닌 속성은 고정된 값을 쓴다.
    """
    scaler = logit.named_steps["standardscaler"]
    lr = logit.named_steps["logisticregression"]
    w = lr.coef_[0] / scaler.scale_
    b0 = float(lr.intercept_[0] - np.sum(lr.coef_[0] * scaler.mean_ / scaler.scale_))
    idx = {f: i for i, f in enumerate(selected)}
    a = b0 + sum(w[idx[f]] * fixed[f] for f in selected if f not in (x_feat, y_feat))
    bx, by = float(w[idx[x_feat]]), float(w[idx[y_feat]])

    pts = []
    for x in xr:
        if abs(by) > 1e-12:
            y = -(a + bx * x) / by
            if yr[0] <= y <= yr[1]:
                pts.append((x, y))
    for y in yr:
        if abs(bx) > 1e-12:
            x = -(a + by * y) / bx
            if xr[0] <= x <= xr[1]:
                pts.append((x, y))
    uniq = []
    for p in pts:
        if not any(abs(p[0] - q[0]) < 1e-9 and abs(p[1] - q[1]) < 1e-9 for q in uniq):
            uniq.append(p)

    corners = [a + bx * x + by * y for x in xr for y in yr]
    side = None
    if max(corners) < 0:
        side = "아님"
    elif min(corners) >= 0:
        side = "뇌졸중"

    if len(uniq) < 2:
        return None, side
    best = max(
        ((p, q) for p in uniq for q in uniq),
        key=lambda pq: (pq[0][0] - pq[1][0]) ** 2 + (pq[0][1] - pq[1][1]) ** 2,
    )
    return best, side


def tree_dot(tree, X_train, y_train, selected):
    """의사결정트리를 DOT 문자열로 바꾼다. 마디마다 훈련용 사람 수와 뇌졸중 수를 적는다."""
    t = tree.tree_
    path = tree.decision_path(X_train)  # 훈련 자료가 지나간 마디를 센다
    n_all = np.asarray(path.sum(axis=0)).ravel()
    n_pos = np.asarray(path[(y_train.to_numpy() == 1)].sum(axis=0)).ravel()

    lines = [
        "digraph tree {",
        'graph [rankdir=TB, bgcolor="white", nodesep=0.35, ranksep=0.6];',
        'node [shape=box, style="rounded,filled", fontname="sans-serif", fontsize=12, '
        'fontcolor="black", color="#555555"];',
        'edge [fontname="sans-serif", fontsize=12, fontcolor="black", color="#555555"];',
    ]
    leaf_answers = []
    asked = set()
    for i in range(t.node_count):
        n, k = int(n_all[i]), int(n_pos[i])
        stat = f"훈련용 {n}명 중 뇌졸중 {k}명 ({k / n * 100:.1f}%)"
        left, right = t.children_left[i], t.children_right[i]
        if left == -1:  # 더 묻지 않고 답을 내는 마디
            answer = int(np.argmax(t.value[i][0]))
            leaf_answers.append(answer)
            text = "뇌졸중" if answer == 1 else "아님"
            fill = "#fbd5b5" if answer == 1 else "#cfe2f3"
            lines.append(f'n{i} [label="답: {text}\\n{stat}", fillcolor="{fill}"];')
            continue
        feat = selected[t.feature[i]]
        asked.add(feat)
        thr = float(t.threshold[i])
        name = KOREAN[feat]
        if feat in BINARY:
            question = f"{name}이 있나요?"
        elif feat == "age":
            question = f"나이가 {thr:.1f}세 이하인가요?"
        elif feat == "avg_glucose_level":
            question = f"평균 혈당이 {thr:.1f} 이하인가요?"
        else:
            question = f"체질량지수가 {thr:.1f} 이하인가요?"
        lines.append(f'n{i} [label="{question}\\n{stat}", fillcolor="#eeeeee"];')
        # 값이 기준 이하인 쪽이 왼쪽이다. 고혈압·심장병은 '있음'(1)이 오른쪽이다.
        yes_child, no_child = (right, left) if feat in BINARY else (left, right)
        lines.append(f'n{i} -> n{yes_child} [label=" 예"];')
        lines.append(f'n{i} -> n{no_child} [label=" 아니요"];')
    lines.append("}")
    asked_in_order = [f for f in selected if f in asked]
    return "\n".join(lines), leaf_answers, asked_in_order


